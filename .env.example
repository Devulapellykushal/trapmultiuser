# ===========================================
# Quake INVENTORY MANAGEMENT SYSTEM
# Environment Configuration
# ===========================================

# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL) — prefer DATABASE_URL
# Optional query params: ?sslmode=require&connect_timeout=10
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/Quake_inventory

# Legacy (used only if DATABASE_URL is unset)
# POSTGRES_DB=Quake_inventory
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Cloud SQL Connection (Production - Cloud Run only)
# CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Quake Inventory
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Auth — public signup & password reset
AUTH_ALLOW_PUBLIC_SIGNUP=true
AUTH_DEV_RETURN_RESET_TOKEN=false
PASSWORD_RESET_TIMEOUT_MINUTES=60
APP_NAME=Quake Inventory

# SMTP (transactional mail — signup welcome, password reset)
# Brevo example: smtp-relay.brevo.com port 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Pluggable adapter: smtp | console (console logs only, no delivery)
EMAIL_ADAPTER=smtp

# Optional support contact in welcome emails
SUPPORT_EMAIL=
SUPPORT_PHONE=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CSRF Trusted Origins (Production)
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# Development Options
# Set to 'true' to use SQLite instead of PostgreSQL for quick development
USE_SQLITE=false
